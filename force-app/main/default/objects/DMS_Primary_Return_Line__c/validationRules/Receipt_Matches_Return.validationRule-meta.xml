<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Receipt_Matches_Return</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Receipt_Line__c)), OR(Product__c &lt;&gt; Receipt_Line__r.Product__c, Primary_Return__r.Distributor__c &lt;&gt; Receipt_Line__r.Goods_Receipt__r.Distributor__c))</errorConditionFormula>
    <errorMessage>The original receipt line must match this product and distributor.</errorMessage>
</ValidationRule>
