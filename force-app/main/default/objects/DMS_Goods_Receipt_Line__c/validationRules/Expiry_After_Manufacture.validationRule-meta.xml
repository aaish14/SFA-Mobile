<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expiry_After_Manufacture</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Manufacturing_Date__c)), NOT(ISBLANK(Expiry_Date__c)), Expiry_Date__c &lt; Manufacturing_Date__c)</errorConditionFormula>
    <errorMessage>Expiry date cannot precede manufacturing date.</errorMessage>
</ValidationRule>
