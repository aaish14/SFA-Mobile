<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Net_Amount__c</fullName>
    <description>Net Line Amount. DMS schema from the October 15 mentor recordings and SFA &amp; DMS deck. Calculated in Salesforce.</description>
    <formula>ROUND((Cases__c * Case_Price__c - BLANKVALUE(Discount_Amount__c, 0)) * (1 + BLANKVALUE(Tax_Percent__c, 0) / 100), 2)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Net Line Amount</label>
    <precision>18</precision>
    <scale>2</scale>
    <type>Currency</type>
</CustomField>
