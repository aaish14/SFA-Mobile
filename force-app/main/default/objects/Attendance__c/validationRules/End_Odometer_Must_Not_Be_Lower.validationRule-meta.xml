<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Odometer_Must_Not_Be_Lower</fullName>
    <active>true</active>
    <description>Prevents a negative travelled-distance calculation.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Start_Odometer__c)), NOT(ISBLANK(End_Odometer__c)), End_Odometer__c &lt; Start_Odometer__c)</errorConditionFormula>
    <errorDisplayField>End_Odometer__c</errorDisplayField>
    <errorMessage>End Odometer must be greater than or equal to Start Odometer.</errorMessage>
</ValidationRule>
