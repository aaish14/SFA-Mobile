<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Distance_Travelled_Km__c</fullName>
    <description>Automatically calculated from the end odometer minus the start odometer.</description>
    <formula>IF(OR(ISBLANK(Start_Odometer__c), ISBLANK(End_Odometer__c)), NULL, End_Odometer__c - Start_Odometer__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Distance Travelled (KM)</label>
    <precision>10</precision>
    <scale>1</scale>
    <type>Number</type>
</CustomField>
