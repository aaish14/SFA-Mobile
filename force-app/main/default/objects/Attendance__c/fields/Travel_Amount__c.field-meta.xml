<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Travel_Amount__c</fullName>
    <description>Salesforce-calculated travel reimbursement: odometer distance multiplied by the applicable per-kilometre rate.</description>
    <formula>IF(OR(ISBLANK(Distance_Travelled_Km__c), ISBLANK(Travel_Rate_Per_Km__c)), 0, Distance_Travelled_Km__c * Travel_Rate_Per_Km__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Travel Amount</label>
    <precision>16</precision><scale>2</scale><type>Currency</type>
</CustomField>
