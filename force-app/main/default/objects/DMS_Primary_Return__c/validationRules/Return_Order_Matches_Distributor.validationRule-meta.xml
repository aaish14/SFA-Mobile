<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Return_Order_Matches_Distributor</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Primary_Order__c)), Distributor__c &lt;&gt; Primary_Order__r.Distributor__c)</errorConditionFormula>
    <errorMessage>The original order must belong to this distributor.</errorMessage>
</ValidationRule>
