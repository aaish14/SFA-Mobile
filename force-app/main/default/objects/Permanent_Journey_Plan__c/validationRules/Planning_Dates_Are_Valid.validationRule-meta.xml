<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Planning_Dates_Are_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Planning_Start_Date__c)), NOT(ISBLANK(Planning_End_Date__c)), Planning_End_Date__c &lt; Planning_Start_Date__c)</errorConditionFormula>
    <errorDisplayField>Planning_End_Date__c</errorDisplayField>
    <errorMessage>Planning End Date cannot be before Planning Start Date.</errorMessage>
</ValidationRule>
