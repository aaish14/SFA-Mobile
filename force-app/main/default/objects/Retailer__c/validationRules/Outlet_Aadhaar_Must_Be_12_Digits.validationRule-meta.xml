<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Outlet_Aadhaar_Must_Be_12_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Aadhaar_Number__c)), NOT(REGEX(Aadhaar_Number__c, &quot;^[0-9]{12}$&quot;)))</errorConditionFormula>
    <errorDisplayField>Aadhaar_Number__c</errorDisplayField>
    <errorMessage>Aadhaar number must contain exactly 12 digits.</errorMessage>
</ValidationRule>
