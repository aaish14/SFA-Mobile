<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Outlet_Phone_Must_Be_10_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Phone__c)), NOT(REGEX(Phone__c, &quot;^[0-9]{10}$&quot;)))</errorConditionFormula>
    <errorDisplayField>Phone__c</errorDisplayField>
    <errorMessage>Contact number must contain exactly 10 digits.</errorMessage>
</ValidationRule>
