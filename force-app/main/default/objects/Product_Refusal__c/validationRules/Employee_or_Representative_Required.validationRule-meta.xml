<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Employee_or_Representative_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISBLANK(Employee__c), ISBLANK(Sales_Representative__c))</errorConditionFormula>
    <errorMessage>Select the Employee or Sales Representative who recorded this refusal.</errorMessage>
</ValidationRule>
