<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Emergency_Contact_Must_Be_10_Digits</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Emergency_Contact__c)), NOT(REGEX(Emergency_Contact__c, &quot;^[0-9]{10}$&quot;)))</errorConditionFormula>
    <errorDisplayField>Emergency_Contact__c</errorDisplayField>
    <errorMessage>Emergency contact must contain exactly 10 digits.</errorMessage>
</ValidationRule>
